{
  "schema_version": "0.1",
  "title": "机器学习",
  "nodes": [
    { "id": "N001", "label": "机器学习", "definition": "研究让计算机从数据或经验中学习规律并改善任务表现的方法。", "kind": "concept" },
    { "id": "N002", "label": "人工智能", "definition": "研究如何通过计算系统实现学习、推理和决策等智能能力的领域。", "kind": "concept" },
    { "id": "N003", "label": "计算学习理论", "definition": "研究学习算法的可学习性、泛化误差界和计算复杂度的理论。", "kind": "concept" },
    { "id": "N004", "label": "泛化", "definition": "模型将训练中获得的规律用于未见样本并保持良好表现的能力。", "kind": "concept" },
    { "id": "N005", "label": "训练集", "definition": "用于学习模型参数或规律的样本集合。", "kind": "concept" },
    { "id": "N006", "label": "偏差与方差分解", "definition": "通过区分模型的系统性偏离与对训练数据的敏感程度来分析预测误差的方法。", "kind": "method" },
    { "id": "N007", "label": "欠拟合", "definition": "模型过于简单而无法充分捕捉数据规律的现象。", "kind": "concept" },
    { "id": "N008", "label": "过拟合", "definition": "模型过度适应训练数据的细节而使未见数据上的表现下降的现象。", "kind": "concept" },
    { "id": "N009", "label": "学习的计算可行性", "definition": "考察学习任务能否在多项式时间等可接受的计算开销内完成。", "kind": "concept" },
    { "id": "N010", "label": "监督学习", "definition": "利用带有目标标签的训练样本学习输入与输出之间的映射。", "kind": "method" },
    { "id": "N011", "label": "无监督学习", "definition": "从没有人工目标标签的数据中发现结构或模式。", "kind": "method" },
    { "id": "N012", "label": "半监督学习", "definition": "结合有标签数据与无标签数据进行学习的方法。", "kind": "method" },
    { "id": "N013", "label": "强化学习", "definition": "通过与环境交互并接收奖励或惩罚来学习行动策略的方法。", "kind": "method" },
    { "id": "N014", "label": "分类", "definition": "根据输入特征预测样本所属离散类别的任务。", "kind": "task" },
    { "id": "N015", "label": "回归", "definition": "根据输入特征预测连续数值的任务。", "kind": "task" },
    { "id": "N016", "label": "聚类", "definition": "依据样本之间的相似性将数据划分为若干组的任务。", "kind": "task" },
    { "id": "N017", "label": "降维", "definition": "将数据表示转换到更低维空间并尽量保留重要信息的方法。", "kind": "method" },
    { "id": "N018", "label": "机器学习模型", "definition": "通过训练调整内部参数并用于预测或描述数据规律的数学表示。", "kind": "concept" },
    { "id": "N019", "label": "模型选择", "definition": "为特定任务选择合适模型的过程。", "kind": "method" },
    { "id": "N020", "label": "人工神经网络", "definition": "由相互连接的人工神经元组成并通过学习调整连接参数的计算模型。", "kind": "method" },
    { "id": "N021", "label": "人工神经元", "definition": "接收输入信号并经过加权组合与变换后产生输出的计算单元。", "kind": "concept" },
    { "id": "N022", "label": "连接权重", "definition": "控制神经元之间信号影响程度并在学习过程中调整的参数。", "kind": "concept" },
    { "id": "N023", "label": "网络层次结构", "definition": "将神经元组织为输入层、隐藏层和输出层以逐层处理信息的结构。", "kind": "concept" },
    { "id": "N024", "label": "深度学习", "definition": "利用包含多个隐藏层的神经网络学习数据表示与完成任务的方法。", "kind": "method" },
    { "id": "N025", "label": "决策树", "definition": "通过分支条件逐步划分样本并在叶节点给出分类或数值预测的模型。", "kind": "method" },
    { "id": "N026", "label": "随机森林回归", "definition": "结合多棵具有随机性的决策树并对预测取平均以完成回归的方法。", "kind": "method" },
    { "id": "N027", "label": "集成学习", "definition": "组合多个模型的预测以改善整体表现的方法。", "kind": "method" },
    { "id": "N028", "label": "自助采样", "definition": "从原始样本中有放回地随机抽样以构造训练数据的方法。", "kind": "method" },
    { "id": "N029", "label": "支持向量机", "definition": "通过寻找具有较大间隔的决策边界等方式完成分类或回归的监督学习方法。", "kind": "method" },
    { "id": "N030", "label": "核技巧", "definition": "通过核函数隐式计算特征空间中的相似性以处理非线性关系的方法。", "kind": "method" },
    { "id": "N031", "label": "回归分析", "definition": "估计目标变量与输入变量之间关系的一类统计方法。", "kind": "method" },
    { "id": "N032", "label": "线性回归", "definition": "用输入变量的线性组合拟合目标数值的方法。", "kind": "method" },
    { "id": "N033", "label": "正则化", "definition": "通过约束模型参数或增加惩罚项来控制模型复杂度的方法。", "kind": "method" },
    { "id": "N034", "label": "逻辑回归", "definition": "将输入的线性组合映射为类别概率并用于分类的方法。", "kind": "method" },
    { "id": "N035", "label": "多元线性回归", "definition": "此处指同时建模多个输出变量及其与输入变量之间线性关系的方法。", "kind": "method" },
    { "id": "N036", "label": "贝叶斯网络", "definition": "用有向无环图表示随机变量之间条件依赖关系的概率图模型。", "kind": "method" },
    { "id": "N037", "label": "高斯过程", "definition": "任意有限组随机变量都服从联合多元正态分布的随机过程。", "kind": "concept" },
    { "id": "N038", "label": "协方差函数", "definition": "描述高斯过程中不同输入位置对应随机变量之间相关结构的函数。", "kind": "concept" },
    { "id": "N039", "label": "贝叶斯优化", "definition": "利用概率代理模型及其不确定性来选择评估点以优化目标的方法。", "kind": "method" },
    { "id": "N040", "label": "计算机视觉", "definition": "让计算机从图像或视频中提取信息并理解视觉内容的研究领域。", "kind": "task" }
  ],
