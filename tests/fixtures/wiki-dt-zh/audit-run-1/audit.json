  "omissions": [
    {
      "finding_id": "F-005",
      "category": "omission",
      "tier": "core",
      "risk": "medium",
      "evidence": [
        "EV-061"
      ],
      "reason": "资料第 4 页说“ID3, C4.5 和 C5.0 决策树的生成使用信息增益”。知识树只为 ID3 画了“使用 信息增益”的边（E020），C4.5 与 C5.0 只以 related-to 连到信息熵（E022），定义也只说“基于信息论”，没有写出它们使用信息增益。",
      "recommendation": "新增边 N015（C4.5 与 C5.0）uses N011（信息增益）；可把 N015 的定义改为“资料中生成时使用信息增益的两种决策树算法”。"
    },
    {
      "finding_id": "F-006",
      "category": "omission",
      "tier": "supporting",
      "risk": "low",
      "evidence": [
        "EV-003",
        "EV-009",
        "EV-010"
      ],
      "reason": "资料开篇说明决策树学习是“统计学、数据挖掘和机器学习中使用的一种预测建模方法”，并说明用途：在决策分析中“可以向用户形象地展示决策的结果和过程”，在数据挖掘和机器学习中“主要用于描述数据（此后亦可基于习得的预测模型去支持决策）”。知识树没有这些应用领域和用途。",
      "recommendation": "在 N001 的定义中补充“统计学、数据挖掘和机器学习中使用的一种预测建模方法”；可新增 fact 节点“决策树的用途”（在决策分析中展示决策的结果和过程；在数据挖掘和机器学习中主要用于描述数据），以 N001 related-to 该节点相连。"
    },
    {
      "finding_id": "F-007",
      "category": "omission",
      "tier": "supporting",
      "risk": "low",
      "evidence": [
        "EV-007"
      ],
      "reason": "资料第 1 页说“树的每个分支对应一组由逻辑与连接的分类特征，而该分支上的叶节点对应由上述特征可以预测出的分类标签”。N004 只说明了单个节点和分支的含义，没有写出一条分支上的特征以逻辑与连接、共同决定叶节点标签。",
      "recommendation": "在 N004 的定义中补充：“每个分支对应一组由逻辑与连接的特征，该分支上的叶节点对应由这些特征预测出的标签。”"
    },
    {
      "finding_id": "F-008",
      "category": "omission",
      "tier": "supporting",
      "risk": "low",
      "evidence": [
        "EV-022",
        "EV-023",
        "EV-068"
