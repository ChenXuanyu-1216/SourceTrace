    { "evidence_id": "EV-035", "source_id": "slide-07", "page": 7, "type": "table", "content": "指标: F1 分数 | 公式: 2PR / (P+R) | 含义: 精确率与召回率的调和平均", "location": "Table row 4 (F1 分数)", "certainty": "high" },

    { "evidence_id": "EV-036", "source_id": "slide-08", "page": 8, "type": "text", "content": "小结与注意事项", "location": "Title", "certainty": "high" },
