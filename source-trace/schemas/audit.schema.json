{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChenXuanyu-1216/SourceTrace/schemas/audit.schema.json",
  "title": "SourceTrace audit",
  "description": "The audit result. The agent writes `items` and `omissions`; build_report.py checks them against the tree and the evidence index, then adds `summary`, `structure_warnings` and every `finding_id`. Those three are recomputed on every run, so any values the agent writes for them are replaced.",
  "type": "object",
  "required": ["schema_version", "items", "omissions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "summary": { "type": "object" },
    "structure_warnings": { "type": "array" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "omissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/omission" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^EV-[0-9]{3,}$" }
    },
    "risk": { "enum": ["high", "medium", "low"] },
    "text": { "type": "string", "minLength": 1 },
    "item": {
      "type": "object",
      "required": ["target", "verdict", "evidence"],
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string" },
        "target": { "type": "string", "pattern": "^[NE][0-9]{3,}$" },
        "target_type": { "enum": ["node", "edge"] },
        "verdict": { "enum": ["supported", "finding"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "category": {
          "enum": ["conceptual-error", "incorrect-relationship", "unsupported-expansion", "overgeneralization", "ambiguous"]
        },
        "scope": {
          "enum": ["whole", "detail"],
          "description": "unsupported-expansion only: whole (default, medium) when the content is absent from the source, detail (low) when only one added detail of an otherwise supported definition is."
        },
        "risk": { "$ref": "#/$defs/risk" },
        "risk_reason": { "$ref": "#/$defs/text" },
        "reason": {
          "$ref": "#/$defs/text",
          "description": "For a finding: why it is a problem. For a supported item (optional): a short note shown next to it in the confirmed list, e.g. a problem in the source that the verdict had to resolve."
        },
        "recommendation": { "$ref": "#/$defs/text" }
      },
      "if": { "properties": { "verdict": { "const": "finding" } } },
      "then": { "required": ["category", "risk", "reason", "recommendation"] }
    },
    "omission": {
      "type": "object",
      "required": ["category", "tier", "risk", "evidence", "reason", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string" },
        "category": { "const": "omission" },
        "tier": { "enum": ["core", "supporting"], "description": "core = medium by default, supporting = low by default (see audit-rules.md)." },
        "risk": { "$ref": "#/$defs/risk" },
        "risk_reason": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "reason": { "$ref": "#/$defs/text" },
        "recommendation": { "$ref": "#/$defs/text" }
      }
    }
  }
}
